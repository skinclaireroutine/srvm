{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",

    "noEmit": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": ["index.ts", "utils.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.ts"
  ]
}
